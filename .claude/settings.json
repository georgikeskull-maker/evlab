{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git reset --hard *)",
      "Bash(gcloud *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "PowerShell(git push *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gcloud *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(Set-ItemProperty *)",
      "PowerShell(New-ItemProperty *)",
      "PowerShell(reg *)",
      "PowerShell(Set-ExecutionPolicy *)",
      "PowerShell(setx *)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Read(./.env*)",
      "Bash(git -C * push *)",
      "PowerShell(git -C * push *)",
      "Bash(*deploy.ps1*)",
      "PowerShell(*deploy.ps1*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push -f *)",
      "PowerShell(git -C * push --force *)",
      "PowerShell(git -C * push -f *)",
      "Bash(format *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(format *)"
    ]
  }
}
